# Legacy Source Database (cgtrading / Branch DB)
DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=candg_pos_db
DB_USERNAME=root
DB_PASSWORD=

# New Laravel Target Database (candg_pos_db)
DB_TARGET_CONNECTION=mysql
DB_TARGET_HOST=localhost
DB_TARGET_PORT=3306
DB_TARGET_DATABASE=candg_pos_db_main
DB_TARGET_USERNAME=root
DB_TARGET_PASSWORD=

# Active Store Migration Mapping
SOURCE_STORE_RECORD_ID=25
TARGET_STORE_RECORD_ID=f8440b75-72db-460a-87f7-988164e1509d

TABLES=repa_group,repa_member,repa_deposit,repa_gratis_log,repa_group_schedule,repa_member_winner

BATCH_SIZE=1000
MAX_DEPTH=5
DRY_RUN=false
TRUNCATE_TARGET=false

DATE_SCOPE=on
DATE_MODE=range
DATE_COLUMN=created_at
DATE_FROM=2026-10-20
DATE_TO=2026-11-11

SUPPRESS_TRIGGERS=false


AUTO_RESOLVE_FKS=true
AUTO_RESOLVE_TABLES=customer,repa_group
AUTO_RESOLVE_MATCH_FIELDS=name,first_name,last_name,contact,email
AUTO_RESOLVE_NEW_UUID=false


CUSTOMER_MATCH_MODE=match
CUSTOMER_MATCH_FIELDS=name,first_name,last_name,contact,email
CUSTOMER_UPDATE_FIELDS=address,contact,email
CUSTOMER_NEW_UUID=false